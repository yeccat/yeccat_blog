---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/url';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDatetime, tags, cover } = post.data;
const formattedDate = pubDatetime.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group overflow-hidden rounded-xl border border-gray-200 transition-shadow hover:shadow-md dark:border-gray-800">
  <a href={withBase(`/blog/${post.id}/`)} class="block">
    {cover && (
      <div class="aspect-[16/9] w-full overflow-hidden bg-gray-100 dark:bg-gray-800">
        <img
          src={withBase(cover)}
          alt={title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )}
    <div class="p-5">
      <h2 class="text-lg font-bold tracking-tight group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
        {title}
      </h2>
      <p class="mt-2 line-clamp-2 text-sm text-gray-600 dark:text-gray-400">
        {description}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
        <time datetime={pubDatetime.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <>
            <span class="text-gray-300 dark:text-gray-600">|</span>
            <span>{tags.join(', ')}</span>
          </>
        )}
      </div>
    </div>
  </a>
</article>
