---
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 px-4 py-8 text-center sm:flex-row sm:justify-between sm:text-left">
    <p class="text-sm text-gray-500 dark:text-gray-400">
      &copy; {year} yeccat. 保留所有权利。
    </p>
    <div class="flex items-center gap-4">
      <a href="/rss.xml" class="text-sm text-gray-500 transition-colors hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400">
        RSS
      </a>
      <a href="/sitemap-index.xml" class="text-sm text-gray-500 transition-colors hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400">
        Sitemap
      </a>
    </div>
  </div>
</footer>
