---
import { withBase } from '../utils/url';

const homeHref = withBase('/');
const navLinks = [
  { href: homeHref, label: '首页' },
  { href: withBase('/blog/'), label: '博客' },
  { href: withBase('/about/'), label: '关于' },
];

// Astro.url.pathname 包含 base 前缀；统一末尾斜杠后再比较，
// 首页严格相等，避免其他页面也高亮“首页”。
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isActive = (href: string) =>
  href === homeHref ? pathname === homeHref : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur-md dark:border-gray-800 dark:bg-gray-950/80">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a href={homeHref} class="text-lg font-bold tracking-tight">
      yeccat<span class="text-indigo-600 dark:text-indigo-400">.blog</span>
    </a>

    <!-- 桌面端导航 -->
    <ul class="hidden items-center gap-6 sm:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'text-indigo-600 dark:text-indigo-400'
                : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- 移动端汉堡菜单按钮 -->
    <button
      id="menu-toggle"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-gray-600 hover:bg-gray-100 sm:hidden dark:text-gray-400 dark:hover:bg-gray-800"
      aria-label="切换菜单"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
  </nav>

  <!-- 移动端下拉菜单 -->
  <div id="mobile-menu" class="hidden border-t border-gray-200 sm:hidden dark:border-gray-800">
    <ul class="flex flex-col gap-1 px-4 py-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'bg-indigo-50 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-400'
                : 'text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }
</script>
