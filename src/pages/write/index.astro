---
import '../../styles/global.css';
import { withBase } from '../../utils/url';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>写文章 — yeccat.blog</title>
    <!-- is:global：编辑区内的标题等节点是运行时动态生成的，没有 Astro scoped 属性 -->
    <style is:global>
      /* 所见即所得编辑区：空内容时显示提示 */
      .wysiwyg:empty::before {
        content: attr(data-placeholder);
        color: #9ca3af;
        pointer-events: none;
      }
      .wysiwyg img {
        max-width: 100%;
        border-radius: 0.5rem;
        margin: 0.75rem 0;
        cursor: default;
      }
      .wysiwyg h1 { font-size: 1.875rem; font-weight: 700; margin: 1rem 0 0.5rem; }
      .wysiwyg h2 { font-size: 1.5rem; font-weight: 700; margin: 1rem 0 0.5rem; }
      .wysiwyg h3 { font-size: 1.25rem; font-weight: 700; margin: 0.75rem 0 0.5rem; }
      .wysiwyg p { margin: 0.5rem 0; }
      .wysiwyg ul { list-style: disc; padding-left: 1.5rem; margin: 0.5rem 0; }
      .wysiwyg ol { list-style: decimal; padding-left: 1.5rem; margin: 0.5rem 0; }
      .wysiwyg blockquote {
        border-left: 4px solid #d1d5db;
        padding-left: 1rem;
        color: #4b5563;
        font-style: italic;
        margin: 0.75rem 0;
      }
      .wysiwyg pre {
        background: #111827;
        color: #f3f4f6;
        border-radius: 0.5rem;
        padding: 1rem;
        overflow-x: auto;
        font-family: ui-monospace, monospace;
        font-size: 0.875rem;
        margin: 0.75rem 0;
      }
      .wysiwyg a { color: #4f46e5; text-decoration: underline; }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 2rem;
        padding: 0 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: #374151;
        user-select: none;
      }
      .tool-btn:hover { background: #f3f4f6; }
      .dark .tool-btn { color: #d1d5db; }
      .dark .tool-btn:hover { background: #1f2937; }
    </style>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100">
    <!-- 顶部工具栏 -->
    <header class="sticky top-0 z-40 border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-gray-950/90">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-3">
        <div class="flex items-center gap-3">
          <a href={withBase('/')} class="text-lg font-bold tracking-tight">
            yeccat<span class="text-indigo-600 dark:text-indigo-400">.blog</span>
          </a>
          <span class="hidden text-sm text-gray-400 sm:inline" id="page-mode">写文章</span>
        </div>
        <div class="flex items-center gap-2">
          <a href={withBase('/manage/')} class="hidden rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 sm:inline-block dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">
            管理文章
          </a>
          <button id="btn-import-md" type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">
            导入 MD
          </button>
          <button id="btn-key" type="button" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">
            <span id="key-label">导入密钥</span>
          </button>
          <button id="btn-publish" type="button" class="rounded-lg bg-indigo-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50">
            发布
          </button>
        </div>
      </div>
    </header>

    <input id="file-md" type="file" accept=".md,.markdown,text/markdown" class="hidden" />
    <input id="file-image" type="file" accept="image/*" class="hidden" />
    <input id="file-cover" type="file" accept="image/*" class="hidden" />

    <main class="mx-auto max-w-6xl px-4 py-6">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_300px]">
        <!-- 左侧：标题 / 工具栏 / 正文 -->
        <section class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900 sm:p-6">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_220px]">
            <input
              id="f-title"
              type="text"
              placeholder="标题"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-lg font-semibold outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-gray-700 dark:bg-gray-950"
            />
            <input
              id="f-slug"
              type="text"
              placeholder="slug（留空自动生成）"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-gray-700 dark:bg-gray-950"
            />
          </div>

          <!-- 格式工具栏（mousedown 阻止失焦，保持选区） -->
          <div class="mt-3 flex flex-wrap items-center gap-0.5 rounded-lg border border-gray-200 bg-gray-50 px-2 py-1.5 dark:border-gray-800 dark:bg-gray-950" id="toolbar">
            <button type="button" class="tool-btn" data-cmd="undo" title="撤销 (Ctrl+Z)">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" /></svg>
            </button>
            <button type="button" class="tool-btn" data-cmd="redo" title="重做 (Ctrl+Y)">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l6-6m0 0l-6-6m6 6H9a6 6 0 100 12h3" /></svg>
            </button>
            <span class="mx-1 h-5 w-px bg-gray-300 dark:bg-gray-700"></span>
            <button type="button" class="tool-btn" data-block="P" title="正文">正文</button>
            <button type="button" class="tool-btn font-bold" data-block="H2" title="大标题">大标题</button>
            <button type="button" class="tool-btn text-sm font-semibold" data-block="H3" title="小标题">小标题</button>
            <span class="mx-1 h-5 w-px bg-gray-300 dark:bg-gray-700"></span>
            <button type="button" class="tool-btn font-bold" data-cmd="bold" title="粗体 (Ctrl+B)">B</button>
            <button type="button" class="tool-btn italic" data-cmd="italic" title="斜体 (Ctrl+I)">I</button>
            <button type="button" class="tool-btn underline" data-cmd="underline" title="下划线 (Ctrl+U)">U</button>
            <button type="button" class="tool-btn" data-cmd="strikeThrough" title="删除线">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.995 9.5H6m0 0h12M6 9.5a5.5 5.5 0 019.914-3.312M6 9.5a5.5 5.5 0 009.914 3.312M4 13h16m-8 8v-3" /></svg>
            </button>
            <span class="mx-1 h-5 w-px bg-gray-300 dark:bg-gray-700"></span>
            <button type="button" class="tool-btn" data-cmd="insertUnorderedList" title="无序列表">• 列表</button>
            <button type="button" class="tool-btn" data-cmd="insertOrderedList" title="有序列表">1. 列表</button>
            <button type="button" class="tool-btn" data-block="BLOCKQUOTE" title="引用">引用</button>
            <button type="button" class="tool-btn" data-block="PRE" title="代码块">代码</button>
            <span class="mx-1 h-5 w-px bg-gray-300 dark:bg-gray-700"></span>
            <button type="button" class="tool-btn" data-cmd="createLink" title="插入链接">链接</button>
            <button type="button" class="tool-btn" id="btn-image" title="上传并插入图片（也可以直接 Ctrl+V 粘贴图片）">图片</button>
            <button type="button" class="tool-btn" data-cmd="removeFormat" title="清除格式">清除</button>
          </div>

          <!-- 所见即所得编辑区 -->
          <div
            id="editor"
            class="wysiwyg mt-3 min-h-[50vh] rounded-lg border border-gray-300 px-4 py-3 text-[15px] leading-relaxed outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-gray-700 dark:bg-gray-950"
            contenteditable="true"
            data-placeholder="在这里直接写：粘贴图片会自动上传，加粗、标题点工具栏立刻生效，Ctrl+Z 撤销，Ctrl+Y 重做…"
          ></div>
        </section>

        <!-- 右侧：封面 / 元信息 -->
        <aside class="flex flex-col gap-6">
          <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
            <p class="mb-2 text-sm font-semibold">封面</p>
            <div id="cover-preview" class="hidden">
              <img id="cover-img" alt="封面预览" class="aspect-[16/9] w-full rounded-lg border border-gray-200 object-cover dark:border-gray-800" />
              <div class="mt-2 flex justify-between">
                <button id="btn-cover-replace" type="button" class="text-xs text-indigo-600 hover:underline dark:text-indigo-400">更换封面</button>
                <button id="btn-cover-remove" type="button" class="text-xs text-red-500 hover:underline">移除封面</button>
              </div>
            </div>
            <button id="btn-cover" type="button" class="flex aspect-[16/9] w-full items-center justify-center rounded-lg border border-dashed border-gray-300 text-3xl text-gray-400 hover:border-indigo-500 hover:text-indigo-500 dark:border-gray-700">
              +
            </button>
          </div>

          <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
            <p class="mb-2 text-sm font-semibold">元信息</p>
            <textarea
              id="f-desc"
              rows="3"
              placeholder="为这篇文章写一段简短摘要"
              class="w-full resize-y rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-gray-700 dark:bg-gray-950"
            ></textarea>
            <input
              id="f-tag-input"
              type="text"
              placeholder="添加标签（按回车）"
              class="mt-3 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-gray-700 dark:bg-gray-950"
            />
            <div id="tag-list" class="mt-2 flex flex-wrap gap-2"></div>
            <input
              id="f-date"
              type="datetime-local"
              class="mt-3 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-gray-700 dark:bg-gray-950"
            />
            <label class="mt-3 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
              <input id="f-draft" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-indigo-600" />
              隐藏此文章（保存但不在线上展示）
            </label>
          </div>
        </aside>
      </div>

      <!-- 状态提示 -->
      <div id="status" class="mt-6 hidden rounded-xl border border-gray-200 bg-white p-4 text-sm dark:border-gray-800 dark:bg-gray-900"></div>
    </main>

    <!-- 密钥弹窗 -->
    <div id="key-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
      <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl dark:bg-gray-900">
        <h3 class="text-lg font-bold">导入 GitHub 密钥</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          密钥是一把仅用于本仓库的 GitHub 令牌，发布时用它把文章提交到仓库。密钥只保存在当前浏览器
          （localStorage），仅发送给 api.github.com，不会经过任何第三方。
        </p>
        <ol class="mt-3 list-decimal space-y-1 pl-5 text-xs text-gray-500 dark:text-gray-400">
          <li>打开 GitHub「Settings → Developer settings → Fine-grained tokens」生成令牌</li>
          <li>Repository access 只选 <code class="rounded bg-gray-100 px-1 dark:bg-gray-800">yeccat_blog</code></li>
          <li>权限：Contents = Read and write，Actions = Read-only</li>
          <li>复制令牌（github_pat_ 开头）粘贴到下方</li>
        </ol>
        <input
          id="key-input"
          type="password"
          placeholder="github_pat_xxxxxxxxxxxx"
          class="mt-4 w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-sm outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-gray-700 dark:bg-gray-950"
        />
        <p id="key-error" class="mt-2 hidden text-xs text-red-500"></p>
        <div class="mt-4 flex justify-end gap-2">
          <button id="key-cancel" type="button" class="rounded-lg border border-gray-300 px-4 py-2 text-sm dark:border-gray-700">取消</button>
          <button id="key-save" type="button" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">验证并保存</button>
        </div>
      </div>
    </div>

    <script>
      import { marked } from 'marked';
      import TurndownService from 'turndown';

      const OWNER = 'yeccat';
      const REPO = 'yeccat_blog';
      const BRANCH = 'main';
      const API = `https://api.github.com/repos/${OWNER}/${REPO}`;
      const RAW = `https://raw.githubusercontent.com/${OWNER}/${REPO}/${BRANCH}`;
      const TOKEN_KEY = 'yeccat_blog_gh_token';
      const BASE = import.meta.env.BASE_URL; // 末尾带 /
      const siteUrl = (p: string) => `${BASE}${p.replace(/^\/+/, '')}`;

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const editor = $('editor');
      const titleEl = $<HTMLInputElement>('f-title');
      const slugEl = $<HTMLInputElement>('f-slug');
      const descEl = $<HTMLTextAreaElement>('f-desc');
      const tagInput = $<HTMLInputElement>('f-tag-input');
      const tagList = $('tag-list');
      const dateEl = $<HTMLInputElement>('f-date');
      const draftEl = $<HTMLInputElement>('f-draft');
      const statusEl = $('status');
      const modal = $('key-modal');
      const keyInput = $<HTMLInputElement>('key-input');
      const keyError = $('key-error');
      const keyLabel = $('key-label');
      const btnPublish = $<HTMLButtonElement>('btn-publish');

      // 编辑模式：/write/?slug=xxx
      const editSlug = new URLSearchParams(location.search).get('slug');
      if (editSlug) $('page-mode').textContent = `编辑文章：${editSlug}`;

      let tags: string[] = [];
      // 封面状态：'' 无封面；/covers|/images 开头为仓库相对路径（新上传或沿用旧封面）
      let coverPath = '';
      let publishMode = false;
      let busy = false;

      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const setStatus = (html: string, tone: 'info' | 'ok' | 'err' = 'info') => {
        statusEl.classList.remove('hidden', 'border-red-300', 'border-green-300', 'border-gray-200');
        statusEl.classList.add(tone === 'err' ? 'border-red-300' : tone === 'ok' ? 'border-green-300' : 'border-gray-200');
        statusEl.innerHTML = html;
      };
      const nowLocalInput = () => {
        const d = new Date();
        const pad = (n: number) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
      };
      const autoSlug = () => {
        const d = new Date();
        const pad = (n: number) => String(n).padStart(2, '0');
        return `post-${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}`;
      };
      dateEl.value = nowLocalInput();
      function yamlStr(s: string) {
        return `"${s.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
      }

      // ---------- 标签 ----------
      function renderTags() {
        tagList.innerHTML = '';
        tags.forEach((t, i) => {
          const chip = document.createElement('span');
          chip.className = 'inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2.5 py-1 text-xs text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300';
          chip.textContent = t;
          const x = document.createElement('button');
          x.type = 'button';
          x.textContent = '×';
          x.className = 'text-indigo-400 hover:text-indigo-700';
          x.onclick = () => { tags.splice(i, 1); renderTags(); };
          chip.appendChild(x);
          tagList.appendChild(chip);
        });
      }
      const flushTagInput = () => {
        const v = tagInput.value.trim().replace(/^,|,$/g, '');
        if (v && !tags.includes(v)) tags.push(v);
        tagInput.value = '';
        renderTags();
      };
      tagInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); flushTagInput(); }
      });
      tagInput.addEventListener('blur', flushTagInput);

      // ---------- 所见即所得工具栏 ----------
      // 回车生成 <p>（默认的 <div> 转出 Markdown 会丢段落空行）
      document.execCommand('defaultParagraphSeparator', false, 'p');
      const exec = (command: string, value?: string) => {
        editor.focus();
        document.execCommand(command, false, value);
      };
      document.querySelectorAll<HTMLButtonElement>('#toolbar [data-cmd]').forEach((btn) => {
        // mousedown 阻止默认，避免点击按钮时编辑区丢失光标
        btn.addEventListener('mousedown', (e) => e.preventDefault());
        btn.addEventListener('click', () => {
          const cmd = btn.dataset.cmd!;
          if (cmd === 'createLink') {
            const sel = window.getSelection()?.toString() ?? '';
            const url = window.prompt('输入链接地址：', 'https://');
            if (!url || url === 'https://') return;
            if (sel) exec('createLink', url);
            else document.execCommand('insertHTML', false, `<a href="${url}">${url.replace(/^https?:\/\//, '')}</a>`);
            return;
          }
          exec(cmd);
        });
      });
      document.querySelectorAll<HTMLButtonElement>('#toolbar [data-block]').forEach((btn) => {
        btn.addEventListener('mousedown', (e) => e.preventDefault());
        btn.addEventListener('click', () => exec('formatBlock', btn.dataset.block!));
      });

      // ---------- 封面 ----------
      const coverPreview = $('cover-preview');
      const coverImg = $<HTMLImageElement>('cover-img');
      const coverBtn = $('btn-cover');
      const coverFileInput = $<HTMLInputElement>('file-cover');
      const showCover = (src: string) => {
        coverImg.src = src;
        coverPreview.classList.remove('hidden');
        coverBtn.classList.add('hidden');
      };
      const hideCover = () => {
        coverPath = '';
        coverFileInput.value = '';
        coverPreview.classList.add('hidden');
        coverBtn.classList.remove('hidden');
      };
      coverBtn.addEventListener('click', () => coverFileInput.click());
      $('btn-cover-replace').addEventListener('click', () => coverFileInput.click());
      $('btn-cover-remove').addEventListener('click', hideCover);

      // ---------- 图片上传（工具栏 / 粘贴 / 封面） ----------
      const imageInput = $<HTMLInputElement>('file-image');
      $('btn-image').addEventListener('mousedown', (e) => e.preventDefault());
      $('btn-image').addEventListener('click', async () => {
        if (!localStorage.getItem(TOKEN_KEY)) { publishMode = true; openModal(); return; }
        imageInput.click();
      });
      imageInput.addEventListener('change', async () => {
        const file = imageInput.files?.[0];
        if (file) await insertImageFile(file);
        imageInput.value = '';
      });

      async function uploadAsset(file: File, dir: string): Promise<string> {
        const token = localStorage.getItem(TOKEN_KEY)!;
        const ext = file.name.split('.').pop()?.toLowerCase().replace(/[^a-z0-9]/g, '') || 'png';
        const repoPath = `/${dir}/${Date.now()}.${ext}`;
        const b64 = await fileToBase64(file);
        await githubPut(`public${repoPath}`, `上传图片 ${file.name}`, b64, token);
        return repoPath; // 如 /images/123.png
      }

      async function insertImageFile(file: File) {
        setStatus(`正在上传图片 ${file.name}…`);
        try {
          const repoPath = await uploadAsset(file, 'images');
          // raw 地址在提交后立即可见；写入正文时用站点路径（turndown 依据 data-repopath 生成）
          const html = `<img src="${RAW}/public${repoPath}" data-repopath="${repoPath}" alt="${file.name.replace(/\.[^.]+$/, '')}" />`;
          editor.focus();
          document.execCommand('insertHTML', false, html);
          setStatus('图片已上传并插入。', 'ok');
        } catch (e) {
          setStatus(`图片上传失败：${(e as Error).message}`, 'err');
        }
      }

      // 直接 Ctrl+V 粘贴图片
      editor.addEventListener('paste', (e) => {
        const items = e.clipboardData?.items;
        if (!items) return;
        for (const item of items) {
          if (item.type.startsWith('image/')) {
            const file = item.getAsFile();
            if (file) {
              e.preventDefault();
              if (!localStorage.getItem(TOKEN_KEY)) {
                alert('粘贴图片需要先导入密钥');
                publishMode = true;
                openModal();
                return;
              }
              insertImageFile(file);
              return;
            }
          }
        }
      });

      coverFileInput.addEventListener('change', async () => {
        const file = coverFileInput.files?.[0];
        if (!file) return;
        setStatus('正在上传封面…');
        try {
          const repoPath = await uploadAsset(file, 'covers');
          coverPath = repoPath;
          showCover(`${RAW}/public${repoPath}`);
          setStatus('封面已上传。', 'ok');
        } catch (e) {
          setStatus(`封面上传失败：${(e as Error).message}`, 'err');
        }
        coverFileInput.value = '';
      });

      // ---------- 导入 Markdown ----------
      const mdInput = $<HTMLInputElement>('file-md');
      $('btn-import-md').addEventListener('click', () => mdInput.click());
      mdInput.addEventListener('change', async () => {
        const file = mdInput.files?.[0];
        if (!file) return;
        const text = await file.text();
        loadMarkdown(text);
        mdInput.value = '';
      });

      function parseFrontmatter(text: string) {
        const fm = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
        if (!fm) return { meta: {} as Record<string, string>, body: text };
        const meta: Record<string, string> = {};
        for (const line of fm[1].split(/\r?\n/)) {
          const m = line.match(/^([a-zA-Z]+):\s*(.*)$/);
          if (m) meta[m[1]] = m[2].trim().replace(/^["']|["']$/g, '');
        }
        return { meta, body: fm[2] };
      }

      function loadMarkdown(text: string) {
        const { meta, body } = parseFrontmatter(text);
        if (meta.title) titleEl.value = meta.title;
        if (meta.description) descEl.value = meta.description;
        if (meta.pubDatetime) {
          const d = new Date(meta.pubDatetime);
          if (!isNaN(d.getTime())) dateEl.value = toLocalInput(d);
        }
        if (meta.cover) {
          coverPath = meta.cover;
          showCover(siteUrl(meta.cover));
        }
        draftEl.checked = meta.draft === 'true';
        tags = [];
        const fm = text.match(/^---\r?\n([\s\S]*?)\r?\n---/);
        if (fm) {
          const inList = fm[1].match(/tags:\r?\n((?:\s*-\s*.+\r?\n?)*)/);
          if (inList) tags = inList[1].split(/\r?\n/).map((s) => s.replace(/^\s*-\s*/, '').replace(/["']/g, '').trim()).filter(Boolean);
          else if (meta.tags && meta.tags.startsWith('[')) tags = meta.tags.replace(/[[\]'"]/g, '').split(',').map((s) => s.trim()).filter(Boolean);
        }
        renderTags();
        editor.innerHTML = marked.parse(body) as string;
      }
      const toLocalInput = (d: Date) => {
        const pad = (n: number) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
      };

      // ---------- HTML → Markdown ----------
      const turndown = new TurndownService({ headingStyle: 'atx', codeBlockStyle: 'fenced', bulletListMarker: '-' });
      turndown.addRule('repoImage', {
        filter: (node: Node) =>
          node.nodeName === 'IMG' && !!(node as HTMLElement).getAttribute?.('data-repopath'),
        replacement: (_content: string, node: Node) => {
          const p = (node as HTMLElement).getAttribute('data-repopath')!;
          const alt = (node as HTMLElement).getAttribute('alt') || '';
          return `![${alt}](${siteUrl(p)})`;
        },
      });

      // ---------- GitHub API ----------
      async function fetchRetry(input: string, init: RequestInit, retries = 2) {
        let lastErr: unknown;
        for (let i = 0; i <= retries; i++) {
          try { return await fetch(input, init); }
          catch (e) { lastErr = e; if (i < retries) await sleep(900 * (i + 1)); }
        }
        throw lastErr;
      }
      async function githubRequest(path: string, opts: RequestInit = {}) {
        const token = localStorage.getItem(TOKEN_KEY)!;
        const r = await fetchRetry(`${API}${path}`, {
          ...opts,
          headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', ...(opts.headers ?? {}) },
        });
        if (!r.ok) {
          let msg = `HTTP ${r.status}`;
          try { msg = (await r.json()).message ?? msg; } catch {}
          const err = new Error(msg);
          (err as Error & { status?: number }).status = r.status;
          throw err;
        }
        return r.status === 204 ? null : r.json();
      }
      async function githubPut(path: string, message: string, contentBase64: string, token: string, sha?: string) {
        const body: Record<string, unknown> = { message, content: contentBase64, branch: BRANCH };
        if (sha) body.sha = sha;
        try {
          const r = await fetchRetry(`${API}/contents/${path}`, {
            method: 'PUT',
            headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!r.ok) {
            let msg = `HTTP ${r.status}`;
            try { msg = (await r.json()).message ?? msg; } catch {}
            throw new Error(msg);
          }
          return r.json();
        } catch {
          // 响应丢失时，通过该文件最近一次提交确认是否其实已成功
          try {
            const commits = await githubRequest(`/commits?path=${encodeURIComponent(path)}&per_page=1`);
            if (Array.isArray(commits) && commits[0]) return { commit: { sha: commits[0].sha }, possiblyCommitted: true };
          } catch {}
          throw new Error('网络中断，且无法确认提交是否成功，请稍后到“管理文章”核对');
        }
      }
      const fileToBase64 = (file: File) =>
        new Promise<string>((resolve, reject) => {
          const r = new FileReader();
          r.onload = () => resolve((r.result as string).split(',')[1]);
          r.onerror = reject;
          r.readAsDataURL(file);
        });

      // ---------- 密钥弹窗 ----------
      function openModal() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        keyInput.value = localStorage.getItem(TOKEN_KEY) ?? '';
        keyError.classList.add('hidden');
        keyInput.focus();
      }
      function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); }
      $('btn-key').addEventListener('click', () => { publishMode = false; openModal(); });
      $('key-cancel').addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      $('key-save').addEventListener('click', async () => {
        const token = keyInput.value.trim();
        keyError.classList.add('hidden');
        if (!token) { keyError.textContent = '请粘贴令牌'; keyError.classList.remove('hidden'); return; }
        try {
          const r = await fetch('https://api.github.com/user', { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json' } });
          if (!r.ok) throw new Error(`令牌无效（${r.status}）`);
          const u = await r.json();
          localStorage.setItem(TOKEN_KEY, token);
          keyLabel.textContent = `密钥：${u.login}`;
          closeModal();
          if (publishMode) { publishMode = false; publish(); }
        } catch (e) {
          keyError.textContent = `验证失败：${(e as Error).message}`;
          keyError.classList.remove('hidden');
        }
      });
      {
        const t = localStorage.getItem(TOKEN_KEY);
        if (t) fetch('https://api.github.com/user', { headers: { Authorization: `Bearer ${t}` } })
          .then((r) => (r.ok ? r.json() : null))
          .then((u) => { if (u?.login) keyLabel.textContent = `密钥：${u.login}`; })
          .catch(() => {});
      }

      // ---------- 加载已有文章（编辑模式） ----------
      async function loadExisting(slug: string) {
        setStatus('正在加载文章…');
        btnPublish.disabled = true;
        try {
          const token = localStorage.getItem(TOKEN_KEY);
          const headers = token ? { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json' } : { Accept: 'application/vnd.github+json' };
          const r = await fetch(`${API}/contents/src/data/blog/${slug}/index.md?ref=${BRANCH}`, { headers });
          if (!r.ok) throw new Error(`文章不存在（${r.status}）`);
          const f = await r.json();
          const text = new TextDecoder().decode(Uint8Array.from(atob(f.content.replace(/\n/g, '')), (c) => c.charCodeAt(0)));
          slugEl.value = slug;
          slugEl.readOnly = true;
          slugEl.classList.add('bg-gray-100', 'dark:bg-gray-800');
          loadMarkdown(text);
          setStatus('已加载文章，修改后点“发布”即可更新。', 'ok');
        } catch (e) {
          setStatus(`加载失败：${(e as Error).message}`, 'err');
        } finally {
          btnPublish.disabled = false;
        }
      }
      if (editSlug) {
        if (!localStorage.getItem(TOKEN_KEY)) { publishMode = false; openModal(); }
        loadExisting(editSlug);
      }

      // ---------- 发布 ----------
      btnPublish.addEventListener('click', () => { if (!busy) publish(); });
      let sessionSlug = '';

      async function publish() {
        flushTagInput();
        const title = titleEl.value.trim();
        const text = editor.innerText.trim();
        if (!title) return alert('请填写标题');
        if (!text && !editor.querySelector('img')) return alert('请填写正文内容');
        if (!localStorage.getItem(TOKEN_KEY)) { publishMode = true; openModal(); return; }

        const slug = (slugEl.value.trim() || sessionSlug || autoSlug()).replace(/^\/+|\/+$/g, '');
        sessionSlug = slug;
        if (!/^[a-zA-Z0-9_-]+$/.test(slug)) return alert('slug 只能包含字母、数字、连字符和下划线');
        const filePath = `src/data/blog/${slug}/index.md`;
        const token = localStorage.getItem(TOKEN_KEY)!;

        busy = true;
        btnPublish.disabled = true;
        try {
          setStatus('正在检查文章…');
          let existingSha: string | undefined;
          try {
            const ex = await githubRequest(`/contents/${filePath}?ref=${BRANCH}`);
            existingSha = ex.sha;
          } catch (e) {
            if ((e as Error & { status?: number }).status !== 404) throw e;
          }

          // 组装 Markdown（封面未改动时沿用原路径）
          const finalCover = coverPath;
          const body = turndown.turndown(editor.innerHTML).trim();
          const d = dateEl.value ? new Date(dateEl.value) : new Date();
          const pub = toLocalInput(d);
          const fm = [
            '---',
            `title: ${yamlStr(title)}`,
            `description: ${yamlStr(descEl.value.trim() || title)}`,
            `pubDatetime: ${pub}`,
            tags.length ? 'tags:' : 'tags: []',
            ...tags.map((t) => `  - ${yamlStr(t)}`),
            `draft: ${draftEl.checked}`,
            ...(finalCover ? [`cover: ${finalCover}`] : []),
            '---',
            '',
          ].join('\n');
          const markdown = `${fm}${body}\n`;

          setStatus(existingSha ? '正在提交更新…' : '正在提交到仓库…');
          const committed = await githubPut(
            filePath,
            existingSha ? `更新文章：${title}` : `发布文章：${title}`,
            btoa(unescape(encodeURIComponent(markdown))),
            token,
            existingSha,
          );
          const sha: string = committed.commit.sha;
          setStatus(`已提交（${sha.slice(0, 7)}），等待自动构建部署，约 1 分钟…`);

          // 轮询部署（单次查询失败不影响已提交的事实）
          const articleUrl = siteUrl(`/blog/${slug}/`);
          let runId: number | null = null;
          for (let i = 0; i < 14; i++) {
            await sleep(5000);
            try {
              const runs = await githubRequest(`/actions/runs?event=push&per_page=10`);
              const run = runs.workflow_runs.find(
                (r: { head_sha: string; path: string }) => r.head_sha === sha && r.path.includes('deploy.yml'),
              );
              if (run) { runId = run.id; break; }
            } catch {}
          }
          if (!runId) {
            finishSuccess(draftEl.checked, articleUrl, '文章已提交，正在后台部署。');
            return;
          }
          for (let i = 0; i < 40; i++) {
            await sleep(5000);
            try {
              const run = await githubRequest(`/actions/runs/${runId}`);
              if (run.status === 'completed') {
                if (run.conclusion === 'success') {
                  finishSuccess(draftEl.checked, articleUrl, '🎉 发布成功！');
                } else {
                  setStatus(`文章已保存，但本次构建失败（${run.conclusion}）。<a class="text-indigo-600 underline" href="https://github.com/${OWNER}/${REPO}/actions/runs/${runId}" target="_blank" rel="noopener">查看构建日志</a>`, 'err');
                }
                return;
              }
              setStatus(`正在构建部署中…（${(i + 1) * 5}s）`);
            } catch {
              setStatus(`正在构建部署中…（网络波动，继续等待 ${(i + 1) * 5}s）`);
            }
          }
          finishSuccess(draftEl.checked, articleUrl, '文章已提交，部署仍在进行。');
        } catch (e) {
          // 兜底：任何失败都核实文件是否其实已经提交成功
          try {
            await githubRequest(`/contents/${filePath}?ref=${BRANCH}`);
            finishSuccess(draftEl.checked, siteUrl(`/blog/${slug}/`), '文章已提交成功（进度查询中断，不影响发布）。');
            return;
          } catch {}
          setStatus(`发布失败：${(e as Error).message}`, 'err');
        } finally {
          busy = false;
          btnPublish.disabled = false;
        }
      }

      function finishSuccess(isDraft: boolean, url: string, prefix: string) {
        if (isDraft) {
          setStatus(`${prefix}文章已设为隐藏，线上暂不展示。可到<a class="text-indigo-600 underline" href="${siteUrl('/manage/')}">管理文章</a>查看。`, 'ok');
          return;
        }
        setStatus(`${prefix} 正在跳转到文章… <a class="text-indigo-600 underline" href="${url}">立即查看</a>`, 'ok');
        setTimeout(() => { window.location.href = url; }, 1600);
      }
    </script>
  </body>
</html>
