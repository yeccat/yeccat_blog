---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { withBase } from '../utils/url';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 5);
---

<BaseLayout
  title="yeccat.blog — 个人技术博客"
  description="分享技术笔记、学习心得与生活感悟。"
>
  <section class="mb-12">
    <h1 class="text-3xl font-bold tracking-tight">你好，我是 yeccat</h1>
    <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">
      欢迎来到我的个人博客。在这里，我记录技术学习、项目实践与日常思考。
    </p>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-bold">最新文章</h2>
    <div class="flex flex-col gap-4">
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} />)
      ) : (
        <p class="text-gray-500 dark:text-gray-400">还没有文章，敬请期待。</p>
      )}
    </div>
    {posts.length > 0 && (
      <a href={withBase('/blog/')} class="mt-6 inline-block text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400">
        查看全部文章 →
      </a>
    )}
  </section>
</BaseLayout>
